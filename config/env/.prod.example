# 线上环境配置示例
# 只保留变量名，真实值必须写入被 .gitignore 排除的 config/env/.prod。

# Django 环境切换
DJANGO_SETTINGS_MODULE=
DJANGO_ENVIRONMENT=

# PostgreSQL 配置（线上环境）
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_HOST=

# Django 配置
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
DEBUG=
TRUSTED_PROXY_IPS=
SMS_RATE_LIMIT_HASH_SALT=

# Immudb 配置
IMMUDB_ADMIN_PASSWORD=
IMMUDB_PRIMARY_PORT=
IMMUDB_PRIMARY_METRICS_PORT=
IMMUDB_REPLICA1_PORT=
IMMUDB_REPLICA1_METRICS_PORT=
REPLICATOR_DELAY=

# 后端服务配置
BACKEND_PORT=
GUNICORN_WORKERS=

# Redis 配置（用于 Django cache、Channels WebSocket 和 Celery）
# 在 Docker 环境中，REDIS_HOST 应设置为 Docker 服务名 'redis'
# 在本地开发环境中，可以设置为 'localhost'
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
REDIS_URL=
REDIS_CACHE_URL=
REDIS_CACHE_KEY_PREFIX=

# Celery 配置
# Celery 消息队列和结果存储的 Redis URL
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=


# 腾讯云 COS 配置（用于头像上传）
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_SCHEME=
# 可选：临时凭证场景使用
COS_TOKEN=

# SMS verification code provider
SMS_PROVIDER=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# Text moderation provider and fail policy
TEXT_MODERATION_PROVIDER=tencent
TEXT_MODERATION_FAIL_POLICY=review_required
TEXT_MODERATION_LOCAL_DECISION=review_required
TEXT_MODERATION_SENSITIVE_WORDS=
TEXT_MODERATION_TENCENT_REGION=ap-guangzhou
TEXT_MODERATION_TENCENT_BIZ_TYPE=

TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_SECRET_KEY=
TENCENT_CAPTCHA_ENDPOINT=
TENCENT_CAPTCHA_REGION=
TENCENT_CAPTCHA_TOKEN_TTL=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=
TENCENT_SMS_ENDPOINT=
TENCENT_SMS_TIMEOUT_SECONDS=
TENCENT_SMS_SESSION_PREFIX=

RUNTIME_SNAPSHOT_RETENTION_DAYS=30

# Phase 2 unified runtime memory and Tencent AGSX sandbox.
OPENVIKING_BASE_URL=
OPENVIKING_API_KEY=
OPENVIKING_TIMEOUT=30
AGSX_ENABLED=false
E2B_DOMAIN=
E2B_API_KEY=
AGSX_TEMPLATE=
AGSX_DEFAULT_CPU_CORES=2
AGSX_DEFAULT_MEMORY_MIB=2048
AGSX_DEFAULT_TTL_SECONDS=300
AGSX_NETWORK_POLICY=isolated
AGSX_REQUEST_TIMEOUT_SECONDS=60
AGSX_SANDBOX_CLEANUP_GRACE_SECONDS=120
AGSX_REAPER_BATCH_SIZE=100
AGSX_GLOBAL_MAX_CONCURRENT_SANDBOXES=25
AGSX_FAIL_CLOSED_ON_QUOTA_BACKEND_ERROR=true
AGSX_ESTIMATED_COST_MICRO_UNITS_PER_SECOND_2C2G=0
AGSX_DEFAULT_COMPANY_DAILY_COST_BUDGET_MICRO_UNITS=0
AGSX_GLOBAL_DAILY_COST_BUDGET_MICRO_UNITS=0
AGSX_COST_CURRENCY=CNY
AGSX_ENFORCE_EFFECTIVE_RESOURCES=false
# Change to read_only only after the Phase 4-A production gate passes.
OPENCLAW_LEGACY_WRITE_MODE=read_only
AGENT_RUNTIME_ALERTS_ENABLED=true
AGENT_RUNTIME_ALERT_ORPHAN_MINUTES=15
AGENT_RUNTIME_ALERT_FAILURE_WINDOW_MINUTES=15
AGENT_RUNTIME_ALERT_FAILURE_RATE=0.2
AGENT_RUNTIME_ALERT_FAILURE_MIN_RUNS=10
AGENT_RUNTIME_ALERT_QUOTA_USAGE_RATIO=0.8
AGENT_RUNTIME_ALERT_DEDUP_SECONDS=900
AGENT_RUNTIME_ALERT_REDIS_PREFIX=touming:agent-runtime:alerts
AGSX_ALERT_FAILURE_WINDOW_MINUTES=15
AGSX_ALERT_FAILURE_RATE=0.2
AGSX_ALERT_FAILURE_MIN_CREATES=5
AGENT_RUNTIME_SANDBOX_REDIS_PREFIX=touming:agent-runtime:sandbox-leases
AGENT_RUNTIME_SANDBOX_STDOUT_LIMIT_BYTES=65536
AGENT_RUNTIME_SANDBOX_STDERR_LIMIT_BYTES=65536
AGENT_RUNTIME_SANDBOX_MAX_ARTIFACT_BYTES=10485760
AGENT_RUNTIME_SANDBOX_MAX_TOTAL_ARTIFACT_BYTES=52428800
AGENT_RUNTIME_SANDBOX_MAX_OVERFLOW_BYTES=5242880
AGENT_RUNTIME_SANDBOX_MAX_ARTIFACT_COUNT=20
AGENT_RUNTIME_ARTIFACT_COS_BUCKET=
AGENT_RUNTIME_ARTIFACT_COS_REGION=
AGENT_RUNTIME_ARTIFACT_COS_SECRET_ID=
AGENT_RUNTIME_ARTIFACT_COS_SECRET_KEY=
AGENT_RUNTIME_ARTIFACT_COS_TOKEN=
AGENT_RUNTIME_ARTIFACT_COS_PREFIX=agent-runtime/v1

