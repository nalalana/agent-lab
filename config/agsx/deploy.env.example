# Touming Phase4-C AGSX production configuration.
#
# Copy this file to /etc/touming/agsx/deploy.env, replace every placeholder,
# keep it outside the Git repository, and set mode 0600 (or 0640 for a
# dedicated operations group). The deployment script parses it as data and
# never executes it as a shell script.

# Tencent Cloud API identity used only by the deployment script and agr.
TENCENTCLOUD_SECRET_ID=<tencent-cloud-secret-id>
TENCENTCLOUD_SECRET_KEY=<tencent-cloud-secret-key>
# Optional: set only when using temporary STS credentials.
TENCENTCLOUD_TOKEN=

# AGSX cloud endpoint and immutable Tool identity.
AGSX_REGION=ap-guangzhou
AGSX_CLI_DOMAIN=tencentags.com
AGSX_TOOL_NAME=<immutable-production-tool-name>
AGSX_TOOL_DESCRIPTION=Touming production isolated code sandbox
AGSX_CLIENT_TOKEN=<unique-idempotency-token-max-64-chars>
AGSX_ROLE_ARN=qcs::cam::uin/<root-account-uin>:roleName/<deployed-agsx-runtime-role>

# Already deployed personal CCR or TCR Enterprise repository.
AGSX_IMAGE_REGISTRY_TYPE=personal
AGSX_IMAGE_REGISTRY_HOST=ccr.ccs.tencentyun.com
AGSX_IMAGE_REPOSITORY=<registry-namespace>/touming-code
AGSX_REGISTRY_USERNAME=<registry-username-or-account-id>
AGSX_REGISTRY_PASSWORD=<registry-password>
AGSX_IMAGE_TAG=<release-date>-<git-short-sha>

# Approved Tencent base image pinned by digest.
AGSX_BASE_IMAGE=ccr.ccs.tencentyun.com/ags-image/sandbox-code@sha256:21b067114e8615b607b7b377e7a2e5ef8e6160c6525059f1d9628a9ec637003a
AGSX_DOCKERFILE=config/agsx/Dockerfile
AGSX_BUILD_CONTEXT=config/agsx

# Phase4-C Tool invariants. The deployment script rejects different values.
AGSX_DEFAULT_TIMEOUT=5m
AGSX_CPU=2
AGSX_MEMORY=2Gi
AGSX_NETWORK_MODE=SANDBOX
AGSX_PERSISTENT=false
AGSX_ENVIRONMENT=production
AGSX_OWNER=agent-platform
AGSX_TOOL_POLL_SECONDS=5
AGSX_TOOL_POLL_ATTEMPTS=60
AGSX_RELEASE_ROOT=/var/lib/touming/agsx/releases
# Generated runtime-only file mounted into Backend/Celery by Compose.
AGSX_RUNTIME_ENV_PATH=/etc/touming/agsx/runtime.env

# Backend/Celery AGSX runtime configuration. Production settings load only this
# explicit runtime allowlist; deployment-only secrets above are not imported.
AGSX_ENABLED=true
E2B_DOMAIN=<deployed-agsx-service-domain-without-scheme>
E2B_API_KEY=<deployed-agsx-api-key>
AGSX_TEMPLATE=<same-value-as-AGSX_TOOL_NAME>
AGSX_DEFAULT_CPU_CORES=2
AGSX_DEFAULT_MEMORY_MIB=2048
AGSX_DEFAULT_TTL_SECONDS=300
AGSX_NETWORK_POLICY=isolated
AGSX_REQUEST_TIMEOUT_SECONDS=60
AGSX_SANDBOX_CLEANUP_GRACE_SECONDS=120
AGSX_REAPER_BATCH_SIZE=100
AGSX_GLOBAL_MAX_CONCURRENT_SANDBOXES=25
AGSX_FAIL_CLOSED_ON_QUOTA_BACKEND_ERROR=true
AGSX_ESTIMATED_COST_MICRO_UNITS_PER_SECOND_2C2G=<positive-production-rate>
AGSX_DEFAULT_COMPANY_DAILY_COST_BUDGET_MICRO_UNITS=<positive-company-budget>
AGSX_GLOBAL_DAILY_COST_BUDGET_MICRO_UNITS=<positive-global-budget>
AGSX_COST_CURRENCY=CNY
AGSX_ENFORCE_EFFECTIVE_RESOURCES=true
AGSX_ALERT_FAILURE_WINDOW_MINUTES=15
AGSX_ALERT_FAILURE_RATE=0.2
AGSX_ALERT_FAILURE_MIN_CREATES=5

# Dedicated Agent Runtime artifact COS configuration.
AGENT_RUNTIME_ARTIFACT_COS_BUCKET=<artifact-cos-bucket>
AGENT_RUNTIME_ARTIFACT_COS_REGION=ap-guangzhou
AGENT_RUNTIME_ARTIFACT_COS_SECRET_ID=<artifact-cos-secret-id>
AGENT_RUNTIME_ARTIFACT_COS_SECRET_KEY=<artifact-cos-secret-key>
# Optional for temporary COS credentials.
AGENT_RUNTIME_ARTIFACT_COS_TOKEN=
AGENT_RUNTIME_ARTIFACT_COS_PREFIX=agent-runtime/v1
