[Unit]
Description=Touming immudb daily backup
Documentation=docs/backup-immudb-openclaw-dr.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/touming/immudb-backup.env
ExecStart=/usr/bin/bash /opt/touming-ops/backup_81_touming.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
